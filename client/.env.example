# REST API base (must include /api)
VITE_API_URL=https://dialoguex-backend.onrender.com/api

# Socket.IO server root (NO /api). Optional if it matches the API host:
# when omitted, the client derives it from VITE_API_URL.
VITE_SOCKET_URL=https://dialoguex-backend.onrender.com

# Optional Telegram bot user id shown as a special contact
# VITE_TELEGRAM_USER_ID=

# Optional: only this DialogueX user may message TelegramBot (dileep's Mongo _id)
# Falls back to the known owner id if unset.
# VITE_TELEGRAM_OWNER_USER_ID=
